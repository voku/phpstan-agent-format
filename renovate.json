{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "packageRules": [
    {
      "description": "Automerge patch updates only after the existing test CI succeeds",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    }
  ]
}
